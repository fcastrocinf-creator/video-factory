{
  "name": "video-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Herramienta interna para generar videos verticales 9:16 con IA para marcas D2C",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@video-factory/block-compositor-remotion": "workspace:*",
    "@video-factory/block-image-gen-imagen": "workspace:*",
    "@video-factory/block-image-gen-multi": "workspace:*",
    "@video-factory/block-narrator-analyzer": "workspace:*",
    "@video-factory/block-scene-planner": "workspace:*",
    "@video-factory/block-scene-validator": "workspace:*",
    "@video-factory/block-script-processor": "workspace:*",
    "@video-factory/block-subtitles-google": "workspace:*",
    "@video-factory/block-tts-elevenlabs": "workspace:*",
    "@video-factory/block-tts-openai": "workspace:*",
    "@video-factory/block-video-gen-veo": "workspace:*",
    "@video-factory/contracts": "workspace:*",
    "@video-factory/core": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.28.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
