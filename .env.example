# ====================================
# APP
# ====================================
# Password único para entrar al sistema (cambiar)
APP_PASSWORD=cambia_esto_por_un_password_real

# Puerto del servidor
PORT=3000

# URL base (para links en correos, etc.)
APP_URL=http://localhost:3000

# ====================================
# DATABASE
# ====================================
DATABASE_URL=file:./db/local.db

# ====================================
# ELEVENLABS (TTS)
# ====================================
# Obtener en: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# GOOGLE AI (Imagen 4 + Speech-to-Text + Veo 3.1)
# ====================================
# La key debe tener acceso a las APIs:
#   - Generative Language API (Imagen 4 / Gemini)
#   - Cloud Speech-to-Text API
# La forma más simple: crear API key desde https://console.cloud.google.com/apis/credentials
# y habilitar ambas APIs en el mismo project.
# Alternativa: AI Studio (https://aistudio.google.com/app/apikey) cubre Imagen/Gemini pero
# para Speech necesitás una key separada desde Cloud Console (ver GOOGLE_SPEECH_API_KEY abajo).
GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Si tu GOOGLE_AI_API_KEY no tiene acceso a Speech-to-Text, podés especificar
# una key dedicada acá. El bloque subtitles-google la prioriza sobre GOOGLE_AI_API_KEY.
# GOOGLE_SPEECH_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxx

# (Opcional, solo si se usa Vertex AI en vez de Gemini API)
# GOOGLE_PROJECT_ID=tu-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# ====================================
# LOGGING
# ====================================
LOG_LEVEL=info  # debug | info | warn | error
