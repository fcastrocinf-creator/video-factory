# ==============================================================
# Video Factory - variables de entorno
# ==============================================================
# Copia este archivo a `.env` y completa los valores reales:
#     Copy-Item .env.example .env
# El archivo `.env` está en .gitignore: nunca se versiona ni se comparte.
#
# (requerido) = la app no funciona correctamente sin esto
# (opcional)  = solo se usa en ciertos flujos o como proveedor de respaldo

# --------------------------------------------------------------
# APP
# --------------------------------------------------------------
# Password para entrar al sistema. Cámbialo por uno propio. (requerido)
APP_PASSWORD=cambia_esto_por_un_password

# Clave SEPARADA para entrar al panel /admin (Base de Conocimiento, auditoria,
# costos por usuario). Es DISTINTA de APP_PASSWORD: aunque alguien entre a la app,
# NO entra al admin sin esta clave. Vacia = el admin queda cerrado. Pon una propia.
ADMIN_PASSWORD=

PORT=3000
APP_URL=http://localhost:3000

# --------------------------------------------------------------
# BASE DE DATOS (libsql / SQLite local)
# --------------------------------------------------------------
DATABASE_URL=file:./db/local.db

# --------------------------------------------------------------
# OPENAI (requerido)
# Generador de imágenes principal del pipeline (gpt-image-1) y TTS de respaldo.
# Obtener en: https://platform.openai.com/api-keys
# --------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# ELEVENLABS (requerido)
# Voz / narración (TTS principal).
# Obtener en: https://elevenlabs.io/app/settings/api-keys
# --------------------------------------------------------------
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# GOOGLE AI (requerido)
# Visión Gemini (detector/reviewer de escenas), Imagen y Speech-to-Text.
# AI Studio:     https://aistudio.google.com/app/apikey
# Cloud Console: https://console.cloud.google.com/apis/credentials
# --------------------------------------------------------------
GOOGLE_AI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Key dedicada a Cloud Speech-to-Text para los subtítulos. (recomendada)
# El bloque subtitles-google la prioriza sobre GOOGLE_AI_API_KEY si está presente.
GOOGLE_SPEECH_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# VERTEX AI - Google Cloud (recomendado)
# Ruta primaria para la visión Gemini y para Imagen, sin límites diarios.
# GCP_PROJECT_ID: ID del proyecto de Google Cloud.
# GOOGLE_APPLICATION_CREDENTIALS: ruta al JSON del service account
#   (necesita el rol "Vertex AI User"). Crear en:
#   https://console.cloud.google.com/iam-admin/serviceaccounts
# GCP_LOCATION: región de Vertex AI. Default implícito: us-central1.
#   Usada en image-gen-imagen, scene-planner, scene-reviewer, ad-analyzer,
#   composite-layout-detector, scene-validator y video-gen-veo.
# --------------------------------------------------------------
GCP_PROJECT_ID=tu-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\al\service-account.json
GCP_LOCATION=us-central1

# --------------------------------------------------------------
# HIGGSFIELD (opcional)
# Proveedor de respaldo para generación de imagen y video.
# Obtener en: https://higgsfield.ai
# --------------------------------------------------------------
HIGGSFIELD_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HIGGSFIELD_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# KLING AI (opcional)
# Animación image-to-video (bloque scene-animator).
# Obtener en: https://klingai.com
# --------------------------------------------------------------
KLING_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
KLING_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# FAL.AI (opcional)
# Proveedor adicional de generación de imágenes (flux-pro).
# Obtener en: https://fal.ai
# --------------------------------------------------------------
FAL_API_KEY=

# --------------------------------------------------------------
# ANTHROPIC CLAUDE (recomendado — requerido si usas el Copilot o el editor IA)
# Usada en: Copilot flotante (M8), editor IA iterativo (M6), post-render-judge
# (M5), preview-judge por imagen (M2), auto-learn-preset (M7-B),
# burned-text-detector, suggest-feedback, translate-feedback, unified-judge (M9)
# y chat/discuss. La key se trata como INACTIVA si empieza con 'ROTATE_'.
# Obtener en: https://console.anthropic.com/settings/keys
# --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# LOGGING
# --------------------------------------------------------------
LOG_LEVEL=info  # debug | info | warn | error

# --------------------------------------------------------------
# ZAPCAP (opcional)
# Subtítulos automáticos animados estilo CapCut vía API.
# Obtener en: https://zapcap.ai
# Nota: el plan gratuito agrega marca de agua; el plan pago (~$10/mes) la quita.
# --------------------------------------------------------------
ZAPCAP_API_KEY=tu-api-key-de-zapcap
# ZAPCAP_WEBHOOK_SECRET: declarado aquí por referencia pero sin uso activo en
# el código actual (preparado para un webhook futuro de ZapCap). Puede omitirse.
# ZAPCAP_WEBHOOK_SECRET=tu-webhook-secret-de-zapcap

# --------------------------------------------------------------
# BUZON CENTRAL (sync OPT-IN — dejar vacío si no aplica)
# Envía eventos del Cerebro/KB al responsable técnico para aprendizaje central.
# Comportamiento por defecto: OFF (no-op total si las variables están vacías).
# Pide estas variables al responsable técnico si quieres activar la sync.
# --------------------------------------------------------------
# VF_LEARNING_SYNC_URL: URL del endpoint central de aprendizaje.
#   Dejar vacío = sync desactivada (no-op, ninguna llamada de red).
VF_LEARNING_SYNC_URL=
# VF_LEARNING_SYNC_KEY: Bearer token de autenticación para tu instalación.
#   Solo necesario si VF_LEARNING_SYNC_URL está configurada.
VF_LEARNING_SYNC_KEY=

# VF_SYNC_INGEST_KEY: SOLO en la instalación RECEPTORA (la central, normalmente la
#   del owner). Token que el endpoint /api/sync/ingest exige a los clientes (debe
#   coincidir con el VF_LEARNING_SYNC_KEY que se reparte). Vacío = receptor apagado.
VF_SYNC_INGEST_KEY=

# === Consejo de mejora continua (auto-auditoria) ===
# VF_AUTO_AUDIT: "1" para que el Consejo (deepAudit) corra SOLO de forma agrupada
#   al terminar los videos. Vacio/0 = solo manual (boton "Auditar a fondo").
#   OFF por defecto. Nada se auto-aplica: el Consejo solo observa y propone.
VF_AUTO_AUDIT=
# VF_AUTO_AUDIT_EVERY: cada cuantos videos terminados se dispara (default 5).
VF_AUTO_AUDIT_EVERY=
# VF_AUTO_AUDIT_MAX_HOURS: ademas, dispara si pasaron tantas horas sin auditar (default 24).
VF_AUTO_AUDIT_MAX_HOURS=

# === Compuerta de calidad video+audio (quality-gate) ===
# Corre el panel de validators sobre un render YA producido y deriva un VEREDICTO
# determinista pass/revisar/fail. Nada se auto-aplica (solo propone). Estas vars
# ajustan la POLITICA de decision; vacias = los defaults del codigo.
# VF_GATE_FAIL_ON: severidad minima que vuelca a "fail" (high | critical). Default critical.
VF_GATE_FAIL_ON=
# VF_GATE_REVIEW_ON: severidad minima que vuelca a "revisar" si no hay fail (medium | high). Default high.
VF_GATE_REVIEW_ON=
# VF_GATE_USE_GEMINI: "1" para enchufar el juez Gemini video+audio (mira lipsync,
#   ritmo de cortes y audio del render). Vacio/0 = solo el panel sobre keyframes.
VF_GATE_USE_GEMINI=